{
    "name": "tc-team-api",
    "version": "1.0.0",
    "main": "index.js",
    "engines": {
        "node": "20.12.2"
    },
    "license": "MIT",
    "scripts": {
        "lint": "eslint . --ext .ts",
        "lint:fix": "yarn lint --fix",
        "typeorm": "typeorm-ts-node-esm --dataSource ./src/shared/infra/typeorm/index.ts",
        "migration:create": "typeorm-ts-node-esm migration:create",
        "migration:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d ./src/shared/infra/typeorm/data-source.ts",
        "dev:server": "ts-node-dev --respawn --transpile-only --clear --ignore-watch node_modules src/shared/infra/express/server.ts",
        "dev:debug": "yarn dev:server --inspect",
        "prod:server": "npm run dist/src/shared/infra/express/server.js",
        "dev:queue": "ts-node-dev --respawn --transpile-only --clear --ignore-watch node_modules src/shared/infra/bullmq/index.ts",
        "test": "jest --passWithNoTests --no-cache --runInBand",
        "test:watch": "yarn test --watch",
        "test:staged": "yarn test --findRelatedTests",
        "test:coverage": "yarn test --coverage",
        "copyfiles": "copyfiles -u 1 src/**/*.hbs dist/src",
        "build": "rimraf dist && tsc && yarn copyfiles",
        "build:babel": "rimraf dist && babel src --extensions \".js,.ts\" --out-dir dist/src --copy-files && babel tests --extensions \".js,.ts\" --out-dir dist/tests",
        "start": "node dist/src/shared/infra/express/server.js",
        "start:queue": "node dist/src/shared/infra/bullmq/index.js",
        "prepare": "husky install"
    },
    "dependencies": {
        "aws-sdk": "^2.1082.0",
        "bcryptjs": "^2.4.3",
        "bullmq": "^1.68.0",
        "class-transformer": "^0.5.1",
        "copyfiles": "^2.4.1",
        "cors": "^2.8.5",
        "date-fns": "^2.28.0",
        "dotenv": "^15.0.0",
        "express": "^4.17.2",
        "express-async-errors": "^3.1.1",
        "handlebars": "^4.7.7",
        "ioredis": "^5.0.4",
        "jest": "^27.4.7",
        "jsonwebtoken": "^8.5.1",
        "multer": "^1.4.4",
        "mysql2": "^2.3.3",
        "nodemailer": "^6.7.2",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^3.0.2",
        "socket.io": "^4.4.1",
        "tsyringe": "^4.6.0",
        "typeorm": "^0.3.9",
        "uuid": "^8.3.2"
    },
    "devDependencies": {
        "@babel/cli": "^7.17.6",
        "@babel/core": "^7.17.5",
        "@babel/node": "^7.16.8",
        "@babel/plugin-proposal-class-properties": "^7.16.7",
        "@babel/plugin-proposal-decorators": "^7.17.2",
        "@babel/preset-env": "^7.16.11",
        "@babel/preset-typescript": "^7.16.7",
        "@types/aws-sdk": "^2.7.0",
        "@types/bcryptjs": "^2.4.2",
        "@types/cors": "^2.8.12",
        "@types/dotenv": "^8.2.0",
        "@types/express": "^4.17.13",
        "@types/handlebars": "^4.1.0",
        "@types/ioredis": "^4.28.10",
        "@types/jest": "^27.4.0",
        "@types/jsonwebtoken": "^8.5.8",
        "@types/module-alias": "^2.0.1",
        "@types/multer": "^1.4.7",
        "@types/node": "^17.0.10",
        "@types/nodemailer": "^6.4.4",
        "@types/socket.io": "^3.0.2",
        "@types/uuid": "^8.3.4",
        "@typescript-eslint/eslint-plugin": "^5.10.0",
        "@typescript-eslint/parser": "^5.10.0",
        "babel-plugin-module-resolver": "^4.1.0",
        "babel-plugin-transform-typescript-metadata": "^0.3.2",
        "eslint": "^8.7.0",
        "husky": "^7.0.4",
        "lint-staged": "^12.3.1",
        "ts-jest": "^27.1.3",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^1.1.8",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^4.5.5"
    }
}